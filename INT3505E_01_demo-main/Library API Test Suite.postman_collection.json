		{
			"name": "add new author",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Kiểm tra Status Code phải là 201 Created\r",
							"// Đây là mã thành công chuẩn cho việc tạo mới tài nguyên.\r",
							"pm.test(\"Status code is 201 Created\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Test 2: Kiểm tra response body có chứa message thành công và id\r",
							"pm.test(\"Response body contains success message and new ID\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.message).to.eql(\"Author created successfully\");\r",
							"    pm.expect(jsonData).to.have.property('id');\r",
							"    pm.expect(jsonData.id).to.be.a('number'); // Kiểm tra ID là một con số\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
